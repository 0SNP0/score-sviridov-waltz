% Piano RH. One voice; all brass contributions share each chord's stem.
pianoRightOpening = {
  \clef treble \key e \major \time 3/4
  R2.*52 |
  r4 <cis' e' a' cis''>4-. \f <cis' e' a' cis''>4-. |
  r4 <cis' e' gis' cis''>4-. <cis' e' gis' cis''>4-. |
  r4 <a cis' fis' a'>4-. <a cis' fis' a'>4-. |
  r4 <gis cis' e' gis'>4-. <gis cis' e' gis'>4-. |
  r4 <fis a d' fis'>4-. <fis a d' fis'>4-. |
  r4 <fis a d' fis'>4-. <fis a d' fis'>4-. |
  r4 <a cis' fis' a'>4-. <a cis' fis' a'>4-. |
  r4 <gis d' e' gis'>4-. <gis d' e' gis'>4-. |
  r4 <a cis' fis' a'>4-. <a cis' fis' a'>4-. |
  r4 <gis cis' e' gis'>4-. <gis cis' e' gis'>4-. |
  r4 <fis a cis' fis'>4-. <fis a cis' fis'>4-. |
  r4 <a cis' fis' a'>4-. <a cis' fis' a'>4-. |
  r4 <fis a d' fis'>4-. <fis a d' fis'>4-. |
  r4 <fis a d' fis'>4-. <fis a d' fis'>4-. |
  r4 <fis ais e' fis'>4-. <fis ais e' fis'>4-. |
  r4 <fis b d' fis'>4-. <fis b d' fis'>4-. |
  r4 <cis' e' a' cis''>4-. <cis' e' a' cis''>4-. |
  r4 <cis' e' gis' cis''>4-. <cis' e' gis' cis''>4-. |
  r4 <a cis' fis' a'>4-. <a cis' fis' a'>4-. |
  r4 <gis cis' e' gis'>4-. <gis cis' e' gis'>4-. |
  r4 <fis a d' fis'>4-. <fis a d' fis'>4-. |
  r4 <fis a d' fis'>4-. <fis a d' fis'>4-. |
  r4 <b d' gis' b'>4-. <b d' gis' b'>4-. |
  r4 <a cis' fis' a'>4-. <a cis' fis' a'>4-. |
  % Bars 77–82
  <gis cis' e' gis'>4-. \ff r4 <gis cis' e' gis'>4-. |
  <gis cis' e' gis'>4-. r4 <gis cis' e' gis'>4-. |
  <a cis' fis' a'>4-. r4 <a cis' fis' a'>4-. |
  <a cis' fis' a'>4-. r4 <a cis' fis' a'>4-. |
  <gis cis' e' gis'>4-. r4 <gis cis' e' gis'>4-. |
  <gis bis fis' gis'>4-. r4 <gis bis fis' gis'>4-. |
  <gis cis' e' gis'>4-. r4 r4 |
  R2. | % Bar 84
  % 85–100: same brass reduction.
  r4 <fis gis c' fis'>4-. \f <fis gis c' fis'>4-. |
  r4 <fis gis c' fis'>4-. <fis gis c' fis'>4-. |
  r4 <e gis cis' e'>4-. <e gis cis' e'>4-. |
  r4 <e gis cis' e'>4-. <e gis cis' e'>4-. |
  r4 <fis gis c' fis'>4-. <fis gis c' fis'>4-. |
  r4 <fis gis c' fis'>4-. <fis gis c' fis'>4-. |
  r4 <e gis cis' e'>4-. <e gis cis' e'>4-. |
  r4 <e gis cis' e'>4-. <e gis cis' e'>4-. |
  r4 <f b cis' f'>4-. <f b cis' f'>4-. |
  r4 <f b cis' f'>4-. <f b cis' f'>4-. |
  r4 <fis a cis' fis'>4-. <fis a cis' fis'>4-. |
  r4 <fis a cis' fis'>4-. <fis a cis' fis'>4-. |
  <fis a cis' fis'>4-. r4 r4 |
  <g ais cis' g'>4-. r4 r4 |
  <e a cis' e'>4-. r4 r4 |
  R2. |
  % 101–116: accordion right-hand notes.
  r4 <gis bis fis' gis'>4-. <gis bis fis' gis'>4-. |
  r4 <gis bis fis' gis'>4-. <gis bis fis' gis'>4-. |
  r4 <gis cis' e' gis'>4-. <gis cis' e' gis'>4-. |
  r4 <gis cis' e' gis'>4-. <gis cis' e' gis'>4-. |
  r4 <gis bis fis' gis'>4-. <gis bis fis' gis'>4-. |
  r4 <gis bis fis' gis'>4-. <gis bis fis' gis'>4-. |
  r4 <gis cis' e' gis'>4-. <gis cis' e' gis'>4-. |
  r4 <gis cis' e' gis'>4-. <gis cis' e' gis'>4-. |
  r4 <b cis' eis' gis'>4-. <b cis' eis' gis'>4-. |
  r4 <b cis' eis' gis'>4-. <b cis' eis' gis'>4-. |
  r4 <a cis' fis' a'>4-. <a cis' fis' a'>4-. |
  r4 <a cis' fis' a'>4-. <a cis' fis' a'>4-. |
  <a cis' fis' a'>4-> r4 r4 |
  <a cis' fis' a'>4-> r4 r4 |
  <gis cis' e' gis'>4-. r4 <gis bis fis' gis'>4-. |
  <gis cis' e' gis'>4-. r4 r4 |
}

pianoRightBridge = {
  R2.*36 |
}

pianoRightMusic = { \pianoRightOpening \pianoRightBridge }
pianoRightMusicPlayback = \scorePlayback \pianoRightOpening \pianoRightBridge

% Piano LH. Bass notes from original sounding sources (no contrabass transposition).
pianoLeftOpening = {
  \clef bass \key e \major \time 3/4
  R2.*3 |
  % 4–5: accordion left hand.
  fis,4-. \mf e,4-. dis,4-. |
  cis,4-. \p r4 r4 |
  % Bars 6–52: silent.
  R2.*47 |
  % 53–76: contrabasses and cellos in one octave chord.
  <a, a>2. \f _\markup \italic { "espr." } |
  <gis, gis>2. |
  <fis, fis>2. |
  <e, e>2. |
  <d, d>2. |
  <b,, b,>2. |
  <e,, e,>2. |
  <e,, e,>2. |
  <a,, a,>2. |
  <gis,, gis,>2. |
  <fis, fis>2. |
  <e, e>2. |
  <d, d>2. |
  <a,, a,>2. |
  <fis,, fis,>2. |
  <b,, b,>2. |
  <a, a>2. |
  <gis, gis>2. |
  <fis, fis>2. |
  <e, e>2. |
  <d, d>2. |
  <e,, e,>2. |
  <eis,, eis,>2. |
  <fis,, fis,>2. |
  <gis,, gis,>4 \ff r4 <gis,, gis,>4 |
  <gis,, gis,>4 r4 <gis,, gis,>4 |
  <fis,, fis,>4 r4 <fis,, fis,>4 |
  <fis,, fis,>4 r4 <fis,, fis,>4 |
  <gis,, gis,>4 r4 <gis,, gis,>4 |
  <gis,, gis,>4 r4 <gis,, gis,>4 |
  <cis, cis>4 gis,4-. \mf e,4-. |
  cis,4-. r4 r4 |
  % 85–116: contrabass and cello octaves.
  <dis, dis>4 \f r4 r4 |
  <gis,, gis,>4 r4 r4 |
  <cis, cis>4 r4 r4 |
  <e, e>4 r4 r4 |
  <dis, dis>4 r4 r4 |
  <gis,, gis,>4 r4 r4 |
  <cis, cis>4 r4 r4 |
  <e, e>4 r4 r4 |
  <cis, cis>4 r4 r4 |
  <cis, cis>4 r4 r4 |
  <fis, fis>4 r4 r4 |
  <e, e>4 r4 r4 |
  <dis, dis>4 r4 r4 |
  <e, e>4 r4 r4 |
  <fis, fis>4 r4 r4 |
  R2. |
  <dis, dis>4 r4 r4 |
  <gis,, gis,>4 r4 r4 |
  <cis, cis>4 r4 r4 |
  <e, e>4 r4 r4 |
  <dis, dis>4 r4 r4 |
  <gis,, gis,>4 r4 r4 |
  <cis, cis>4 r4 r4 |
  <e, e>4 r4 r4 |
  <cis, cis>4 r4 r4 |
  <cis, cis>4 r4 r4 |
  <fis, fis>4 r4 r4 |
  <e, e>4 r4 r4 |
  <dis, dis>4 r4 r4 |
  <e, e>4 r4 r4 |
  <gis,, gis,>4 r4 <gis,, gis,>4 |
  <cis, cis>4 r4 r4 |
}

pianoLeftBridge = {
  R2.*36 |
}

pianoLeftMusic = { \pianoLeftOpening \pianoLeftBridge }
pianoLeftMusicPlayback = \scorePlayback \pianoLeftOpening \pianoLeftBridge

% One printed dynamics row between the staves. MIDI retains the dynamics
% attached to each hand; those markings are hidden in print only.
pianoExpressionMarks = {
  \time 3/4
  s2.*3 |       % 1–3
  s2.\pp |       % 4
  s2.*48 |      % 5–52
  s2.\f |       % 53
  s2.*29 |      % 54–82
  s4 s4\mp s4 | % 83, beat 2
  s2. |         % 84
  s2.\p |       % 85
  s2.*67 |      % 86–152
}

pianoRightMusicPrint = { \omit DynamicText \pianoRightMusic }
pianoLeftMusicPrint = { \omit DynamicText \pianoLeftMusic }
